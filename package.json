{
  "name": "cao-saci",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "setup": "pnpm install && pnpm db:setup",
    "dev": "pnpm --parallel --recursive run dev",
    "dev:mock": "pnpm --filter cao-saci-web dev:mock",
    "build": "pnpm --recursive run build",
    "build:mock": "pnpm --filter cao-saci-web build:mock",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --filter cao-saci-api test",
    "db:setup": "pnpm --filter cao-saci-api db:setup",
    "db:reset": "pnpm --filter cao-saci-api db:reset",
    "db:migrate": "pnpm --filter cao-saci-api db:migrate",
    "db:seed": "pnpm --filter cao-saci-api db:seed",
    "db:generate": "pnpm --filter cao-saci-api db:generate"
  }
}
