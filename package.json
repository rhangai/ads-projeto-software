{
  "name": "cao-saci",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter cao-saci-api db:seed && pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "db:seed": "pnpm --filter cao-saci-api db:seed",
    "db:generate": "pnpm --filter cao-saci-api db:generate"
  }
}
